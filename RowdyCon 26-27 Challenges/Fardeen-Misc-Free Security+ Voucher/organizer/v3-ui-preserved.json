{
    "q20":  " case 20:{const tokens=s.tokens.filter((t:any)=\u003e!t.spent);const layers=local.layers||{};const ids=Object.keys(layers);const selected=ids[picked]||ids[0];const bitmap=tokens[0]?.share as Bits|undefined;const output=bitmap?composite(ids.map(id=\u003e({bitmap:tokens.find((t:any)=\u003et.id===id)?.share,...layers[id]})).filter(x=\u003ex.bitmap),bitmap.width,bitmap.height):undefined;scene=\u003c\u003e\u003cdiv className=\"final-token-rack\"\u003e{tokens.map((t:any,i:number)=\u003e\u003cdiv key={t.id} className=\"final-token\"\u003e\u003cbutton className=\"turn-token\" aria-label={`Turn token ${i+1} over`} onClick={()=\u003esetLocal({...local,[\u0027back\u0027+t.id]:!local[\u0027back\u0027+t.id]})}\u003e↶\u003c/button\u003e\u003cDrag id={`share-${t.id}`} label={`Exam token ${i+1}`} className={local[\u0027back\u0027+t.id]?\u0027token-back\u0027:\u0027token-front\u0027}\u003e{local[\u0027back\u0027+t.id]?\u003cBitmap bitmap={t.share} label={`Token ${i+1} reverse pixels`}/\u003e:\u003cspan\u003e➜\u003c/span\u003e}\u003c/Drag\u003e\u003c/div\u003e)}\u003c/div\u003e\u003cDrop id=\"final-viewer\" label=\"Difference viewer registration marks\" className=\"final-viewer\" onPut={p=\u003e{if(p.startsWith(\u0027share-\u0027)){const id=p.slice(6);if(local[\u0027back\u0027+id]){setLocal({...local,layers:{...layers,[id]:{x:0,y:0,rotation:0}}});setPicked(Object.keys(layers).includes(id)?Object.keys(layers).indexOf(id):Object.keys(layers).length);}}}}\u003e\u003cdiv className=\"viewer-bezel\"\u003eDIFFERENCE VIEWER \u003cb\u003e⊕\u003c/b\u003e\u003c/div\u003e\u003cBitmap bitmap={output} label=\"Combined token pixels\"/\u003e\u003cdiv className=\"viewer-slots\"\u003e{tokens.map((t:any,i:number)=\u003e\u003cbutton key={t.id} className={selected===t.id?\u0027selected\u0027:\u0027\u0027} disabled={!layers[t.id]} onClick={()=\u003esetPicked(ids.indexOf(t.id))}\u003e{layers[t.id]?\u0027▣\u0027:\u0027□\u0027} {i+1}\u003c/button\u003e)}\u003c/div\u003e\u003c/Drop\u003e{selected\u0026\u0026\u003c\u003e\u003cViewControls value={layers[selected]} change={v=\u003esetLocal({...local,layers:{...layers,[selected]:v}})}/\u003e\u003cbutton className=\"remove-layer\" onClick={()=\u003e{const next={...layers};delete next[selected];setLocal({...local,layers:next});setPicked(0);}}\u003eREMOVE LAYER\u003c/button\u003e\u003c/\u003e}\u003cbutton className=\"magnify-control\" onClick={()=\u003esetLocal({...local,magnify:!local.magnify})}\u003eMAGNIFY\u003c/button\u003e{local.magnify\u0026\u0026\u003cMagnifier bitmap={output} close={()=\u003esetLocal({...local,magnify:false})}/\u003e}\u003cdiv className=\"certificate-lock\"\u003e\u003cMachine kind=\"lock\"/\u003e\u003clabel\u003ePIN\u003cinput inputMode=\"numeric\" autoComplete=\"off\" maxLength={6} aria-label=\"Certificate PIN\" value={pin} onChange={e=\u003esetPin(e.target.value.replace(/\\D/g,\u0027\u0027))} onKeyDown={e=\u003e{if(e.key===\u0027Enter\u0027)go(\u0027unlock\u0027,{pin});}}/\u003e\u003c/label\u003e{btn(\u0027UNLOCK\u0027,\u0027unlock\u0027,{pin})}\u003c/div\u003e\u003c/\u003e;break;}",
    "q1":  " case 1:scene=\u003c\u003e\u003cdiv className=\"port-grid\"\u003e{(f.numbers||[20,21,23,25]).map((n:number,i:number)=\u003e\u003cDrop id={`port-${i}`} key={n} label={`Port panel ${i+1}`} onPut={p=\u003e{if(p===\u0027plus\u0027)go(\u0027place-plus\u0027,{index:i});}}\u003e\u003cbutton className=\"answer\" disabled={disabled} onClick={()=\u003ego(\u0027answer\u0027,{index:i})}\u003e{n}{d.plusAt===i\u0026\u0026\u003cspan className=\"added-one\"\u003e + 1\u003c/span\u003e}\u003c/button\u003e\u003c/Drop\u003e)}\u003c/div\u003e\u003cDrop id=\"credit\" label=\"Extra credit margin\" className=\"credit-margin\" onPut={p=\u003e{if(p===\u0027plus\u0027)go(\u0027place-plus\u0027,{index:null});}}\u003e\u003cspan\u003eEXTRA CREDIT\u003c/span\u003e\u003cDrag id=\"plus\" label=\"Extra credit plus one\" className=\"credit-token\"\u003e+1\u003c/Drag\u003e\u003c/Drop\u003e\u003cLittleGoose say=\"Multiple choice. Allegedly.\" style={at(365,157,110,83)}/\u003e\u003c/\u003e;break;"
